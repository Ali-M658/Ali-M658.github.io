{
  "manifest_version": 3,
  "name": "Trailhead",
  "version": "0.2.2",
  "description": "Your back button deletes the pages you leave behind. Trailhead keeps every branch and maps all your tabs as one graph.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Trailhead",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "commands": {
    "open-map": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open the Trailhead map"
    },
    "restore-last": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Reopen the page you most recently went back from"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "sidePanel",
    "alarms",
    "favicon",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
